Options -Indexes
<IfModule mod_headers.c>
 Header always set Cache-Control "no-store"
 Header always set X-Content-Type-Options "nosniff"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'none'; object-src 'none'"
</IfModule>
